# Optional: OpenRouteService key. Without it, the planner uses OSRM routing.
ORS_API_KEY=

# Google Maps keys. Do not commit real keys. Restrict the browser key by HTTP
# referrer and the Directions key by server IP address in Google Cloud.
GOOGLE_MAPS_JS_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Development only
FLASK_DEBUG=1
